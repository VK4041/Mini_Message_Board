<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Homepage</title>
</head>

<body>
  <% messages.forEach(message=>{ %>
  <div class="message-card">
    <b><%= message.user %></b>
    <p><%= message.text %>
      <span>sent on <%= message.added.toLocaleDateString() %></span>
    </p>
  </div>
  <hr>
  <%})%>
  <button><a href="/new">New Msg</a></button>
</body>
</html>